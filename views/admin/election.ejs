<%- include('_head', { page: 'election' }) %>

<% if (!election) { %>
    <div class="card">
        <div class="carte-titre">
            <div class="carte-eyebrow">Aucune élection</div>
            <h2>Créez d'abord une élection</h2>
            <p>Il n'y a pas encore d'élection active. Rendez-vous dans l'onglet <strong>Élections</strong> pour en créer une.</p>
        </div>
        <a href="/admin/elections" class="bouton bouton-principal bouton-pleine-largeur bouton-espace-haut">Aller créer une élection</a>
    </div>
<% } else { %>

    <div class="card">
        <div class="admin-card-entete">
            <div class="carte-titre">
                <div class="carte-eyebrow">Tour actuel</div>
                <% if (tourActif) { %>
                    <h2>Tour <%= tourActif.numero %></h2>
                    <p>
                        Candidats qualifiés :
                        <% candidatsDuTourActif.forEach(function(c, i) { %><%= i > 0 ? ', ' : '' %><%= c.prenom %> <%= c.nom %><% }); %>
                    </p>
                <% } else { %>
                    <h2>Aucun tour configuré</h2>
                <% } %>
            </div>
            <% if (tourActif) { %>
                <button type="button" class="bouton bouton-rond" onclick="ouvrirNouveauTour()" aria-label="Lancer un nouveau tour" title="Lancer un nouveau tour">+</button>
            <% } %>
        </div>

        <% if (!tourActif) { %>
            <button type="button" class="bouton bouton-principal bouton-auto bouton-espace-haut" onclick="ouvrirTour1()">Créer le tour 1</button>
        <% } %>
    </div>

    <% if (tours.length > 0) { %>
        <div class="card">
            <div class="carte-titre">
                <div class="carte-eyebrow">Historique</div>
                <h2>Tous les tours</h2>
                <p>Cliquez sur l'icône crayon pour modifier les dates ou le statut d'un tour.</p>
            </div>
            <div class="tableau-propre-conteneur">
                <table class="tableau-propre">
                    <thead>
                    <tr>
                        <th>Tour</th>
                        <th>Ouverture</th>
                        <th>Clôture</th>
                        <th>Statut</th>
                        <th></th>
                    </tr>
                    </thead>
                    <tbody>
                    <% tours.forEach(function(t) { %>
                        <tr>
                            <td data-label="Tour">Tour <%= t.numero %></td>
                            <td data-label="Ouverture"><%= t.dateOuverture %></td>
                            <td data-label="Clôture"><%= t.dateCloture %></td>
                            <td data-label="Statut"><span class="badge <%= t.statut === 'ouverte' ? 'badge-vert' : 'badge-gris' %>"><%= t.statut === 'ouverte' ? 'Ouvert' : 'Fermé' %></span></td>
                            <td data-label="">
                                <div class="cellule-actions">
                                    <button type="button" class="bouton bouton-icone" title="Modifier ce tour"
                                            onclick='ouvrirModifTour(<%- JSON.stringify({
                                                id: t.id,
                                                numero: t.numero,
                                                dateOuverture: t.dateOuverture.slice(0, 16),
                                                dateCloture: t.dateCloture.slice(0, 16),
                                                statut: t.statut
                                            }) %>)'>
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
                                            <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
                                        </svg>
                                    </button>
                                    <a href="/admin/resultats?tour=<%= t.numero %>" class="bouton bouton-discret">Résultats</a>
                                </div>
                            </td>
                        </tr>
                    <% }); %>
                    </tbody>
                </table>
            </div>
        </div>
    <% } %>

    <div class="modale-overlay" id="modaleTour1">
        <div class="modale">
            <div class="modale-titre">Créer le tour 1</div>
            <p class="modale-texte">Le tour sera créé avec les candidats actuellement actifs.</p>
            <form method="POST" action="/admin/election/creer-tour1">
                <div class="champs-grille">
                    <div>
                        <label for="t1dateOuverture">Ouverture du vote</label>
                        <input type="datetime-local" id="t1dateOuverture" name="dateOuverture" required>
                    </div>
                    <div>
                        <label for="t1dateCloture">Clôture du vote</label>
                        <input type="datetime-local" id="t1dateCloture" name="dateCloture" required>
                    </div>
                </div>
                <div class="modale-actions">
                    <button type="submit" class="bouton bouton-principal bouton-pleine-largeur">Créer le tour 1</button>
                    <button type="button" class="bouton bouton-secondaire bouton-pleine-largeur" onclick="fermerTour1()">Annuler</button>
                </div>
            </form>
        </div>
    </div>

    <div class="modale-overlay" id="modaleModifTour">
        <div class="modale">
            <div class="modale-titre" id="modaleModifTourTitre">Modifier le tour</div>
            <form method="POST" id="formModifTour" action="">
                <div class="champs-grille">
                    <div>
                        <label for="mtDateOuverture">Ouverture du vote</label>
                        <input type="datetime-local" id="mtDateOuverture" name="dateOuverture" required>
                    </div>
                    <div>
                        <label for="mtDateCloture">Clôture du vote</label>
                        <input type="datetime-local" id="mtDateCloture" name="dateCloture" required>
                    </div>
                </div>
                <label for="mtStatut">Statut</label>
                <select id="mtStatut" name="statut" class="champ-select">
                    <option value="ouverte">Ouverte (respecte les dates ci-dessus)</option>
                    <option value="fermee">Fermée manuellement</option>
                </select>
                <div class="modale-actions">
                    <button type="submit" class="bouton bouton-principal bouton-pleine-largeur">Enregistrer</button>
                    <button type="button" class="bouton bouton-secondaire bouton-pleine-largeur" onclick="fermerModaleModifTour()">Annuler</button>
                </div>
            </form>
        </div>
    </div>

    <div class="modale-overlay" id="modaleNouveauTour">
        <div class="modale">
            <div class="modale-titre">Lancer un nouveau tour</div>
            <p class="modale-texte">Sélectionnez les candidats qualifiés (généralement les 2 premiers du tour précédent) et définissez les nouvelles dates. Le tour actuel sera automatiquement
                clôturé.</p>
            <form method="POST" action="/admin/election/nouveau-tour"
                  onsubmit="return confirm('Lancer un nouveau tour ? Le tour actuel sera clôturé et les électeurs pourront revoter pour ce nouveau tour.');">
                <label>Candidats qualifiés pour ce nouveau tour</label>
                <div class="candidats-checklist">
                    <% candidats.filter(c => c.valide).forEach(function(c) { %>
                        <label class="checklist-item">
                            <input type="checkbox" name="candidatIds" value="<%= c.id %>">
                            <%= c.prenom %> <%= c.nom %>
                        </label>
                    <% }); %>
                </div>
                <div class="champs-grille">
                    <div>
                        <label for="ndateOuverture">Ouverture du nouveau tour</label>
                        <input type="datetime-local" id="ndateOuverture" name="dateOuverture" required>
                    </div>
                    <div>
                        <label for="ndateCloture">Clôture du nouveau tour</label>
                        <input type="datetime-local" id="ndateCloture" name="dateCloture" required>
                    </div>
                </div>
                <div class="modale-actions">
                    <button type="submit" class="bouton bouton-principal bouton-pleine-largeur">Lancer ce nouveau tour</button>
                    <button type="button" class="bouton bouton-secondaire bouton-pleine-largeur" onclick="fermerModaleNouveauTour()">Annuler</button>
                </div>
            </form>
        </div>
    </div>

    <script>
		var overlayTour1 = document.getElementById('modaleTour1');

		function ouvrirTour1() {
			overlayTour1.classList.add('ouverte');
		}

		function fermerTour1() {
			overlayTour1.classList.remove('ouverte');
		}

		overlayTour1.addEventListener('click', function (e) {
			if (e.target === overlayTour1) fermerTour1();
		});

		var overlayNouveauTour = document.getElementById('modaleNouveauTour');

		function ouvrirNouveauTour() {
			overlayNouveauTour.classList.add('ouverte');
		}

		function fermerModaleNouveauTour() {
			overlayNouveauTour.classList.remove('ouverte');
		}

		overlayNouveauTour.addEventListener('click', function (e) {
			if (e.target === overlayNouveauTour) fermerModaleNouveauTour();
		});

		var overlayModifTour = document.getElementById('modaleModifTour');
		var formModifTour = document.getElementById('formModifTour');

		function ouvrirModifTour(t) {
			formModifTour.action = '/admin/tours/' + t.id;
			document.getElementById('modaleModifTourTitre').textContent = 'Modifier le tour ' + t.numero;
			document.getElementById('mtDateOuverture').value = t.dateOuverture;
			document.getElementById('mtDateCloture').value = t.dateCloture;
			document.getElementById('mtStatut').value = t.statut;
			overlayModifTour.classList.add('ouverte');
		}

		function fermerModaleModifTour() {
			overlayModifTour.classList.remove('ouverte');
		}

		overlayModifTour.addEventListener('click', function (e) {
			if (e.target === overlayModifTour) fermerModaleModifTour();
		});
    </script>

<% } %>

<%- include('_foot') %>